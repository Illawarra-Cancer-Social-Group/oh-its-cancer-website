---
/*
  Home page, from the "Now Showing" mock-up: the drive-in hero, the
  Chookas! banner, cards for each section, then the Synopsis.
*/
import BaseLayout from '../layouts/BaseLayout.astro';
import Hero from '../sections/Hero.astro';
import ChookasBanner from '../sections/ChookasBanner.astro';
import SectionCards from '../sections/SectionCards.astro';
import Synopsis from '../sections/Synopsis.astro';
---

<BaseLayout title="Home">
  <Hero />
  <div class="home-sections surface-dark">
    <ChookasBanner />
    <SectionCards />
    <Synopsis />
  </div>
</BaseLayout>

<style>
  /* Maroon background below the hero, as in the mock-up */
  .home-sections {
    flex: 1;
    background-color: var(--colour-maroon);
  }
</style>
