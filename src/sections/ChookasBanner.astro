---
/*
  ChookasBanner: the mint "Chookas!" banner from the home page mock-up,
  with starbursts and a Cadillac.

  The mock-up had white text on mint, which fails contrast (1.5:1), so the
  text is black (12.82:1). The asterisk points to a real footnote under the
  banner explaining the word (AGENTS.md, section 8).

  The starbursts and car are decoration (hidden from screen readers).
  Sits on a dark (maroon) background.

  Props: none.
*/
import { Image } from 'astro:assets';
import cadillac from '../assets/home/pink-cadillac.png';

// A four-pointed 1950s starburst
const star = 'M12 0 L14 10 L24 12 L14 14 L12 24 L10 14 L0 12 L10 10 Z';
---

<div class="chookas container">
  <div class="chookas__banner">
    <svg class="chookas__stars" viewBox="0 0 60 50" aria-hidden="true" focusable="false">
      <path d={star} transform="translate(0 0) scale(1.4)"></path>
      <path d={star} transform="translate(34 6) scale(0.6)"></path>
      <path d={star} transform="translate(26 30) scale(0.75)"></path>
    </svg>
    <p class="chookas__word">Chookas!<span aria-hidden="true">*</span></p>
    <Image class="chookas__car" src={cadillac} alt="" widths={[400, 800]} sizes="20rem" />
  </div>
  <p class="chookas__note">
    <span aria-hidden="true">*</span>Chookas! is theatre slang for “good luck”.
  </p>
</div>

<style>
  .chookas {
    padding-block: var(--space-2xl) var(--space-l);
  }

  /* Black on mint: approved pair 12.82:1 */
  .chookas__banner {
    display: flex;
    align-items: center;
    gap: var(--space-l);
    padding: var(--space-m) var(--space-l);
    background-color: var(--colour-mint);
    color: var(--colour-black);
    border: 6px solid var(--colour-warm-white);
    border-radius: 1.25rem;
  }

  .chookas__stars {
    flex-shrink: 0;
    width: clamp(3rem, 8vw, 5rem);
    fill: var(--colour-black);
  }

  .chookas__word {
    margin: 0;
    font-family: var(--font-script);
    font-size: clamp(2.75rem, 8vw, 4.5rem);
    line-height: 1.1;
  }

  .chookas__car {
    display: none;
    margin-inline-start: auto;
    width: clamp(12rem, 25vw, 20rem);
  }

  @media (min-width: 48rem) {
    .chookas__car {
      display: block;
    }
  }

  /* Warm white on maroon: approved pair 14.38:1 */
  .chookas__note {
    margin: var(--space-xs) 0 0;
    color: var(--colour-warm-white);
  }
</style>
