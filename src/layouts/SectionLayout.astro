---
/*
  SectionLayout: the page design for About us, Products, People and Connect.
  Like walking into the theatre: a night sky at the top, then the curtain,
  with the content on a lit-up marquee panel.

  - The top band is night sky with starbursts. The plain label is the large
    heading, with the theatre name smaller underneath in script, in the
    section's own colour (AGENTS.md, section 5). Colours are set in
    src/navigation.ts: About mint, Products butter, People pink, Connect green.
  - The section's illustration sits on the right in a soft spotlight
    (speaker box, monster hand, masks or notepad). Decoration only, alt="".
  - Below: a deep red theatre curtain, and the content on a warm white
    panel with a red marquee frame and bulbs. Text only ever sits on the
    solid panel, never on the curtain or the stars.

  Props:
    href         (required) The page's address in src/navigation.ts, e.g. "/products/".
                 The heading, theatre name, colour and page title all come from there.
    description  (optional) One sentence for search engines and link previews.

  Slots:
    default  The page content, shown inside the panel.

  Usage:
    <SectionLayout href="/products/">
      <p>Intro text…</p>
    </SectionLayout>
*/
import { Image } from 'astro:assets';
import BaseLayout from './BaseLayout.astro';
import Starburst from '../components/Starburst.astro';
import { navItem } from '../navigation';

interface Props {
  href: string;
  description?: string;
}

const { href, description } = Astro.props;
const { label, theatreName, colour = 'butter', illustration } = navItem(href);
---

<BaseLayout title={label} description={description}>
  <div class="section-page" style={`--section-colour: var(--colour-${colour});`}>
    <div class="section-page__band">
      <div class="container section-page__top">
        <div class="section-page__heading">
          <h1>{label}</h1>
          {theatreName && <p class="section-page__theatre">{theatreName}</p>}
        </div>
        <Starburst class="section-page__star section-page__star--big" shape="atomic" />
        <Starburst class="section-page__star section-page__star--small" />
        {
          illustration && (
            <span class="section-page__art">
              <Image
                class="section-page__illustration"
                src={illustration}
                alt=""
                widths={[200, 400]}
                sizes="10rem"
              />
            </span>
          )
        }
      </div>
    </div>

    <div class="container">
      <div class="section-page__panel marquee-frame">
        <slot />
      </div>
    </div>
  </div>
</BaseLayout>

<style>
  .section-page {
    flex: 1; /* fills short pages down to the footer */
    padding-block-end: var(--space-3xl);
    /* Deep red theatre curtain: soft folds of maroon. Nothing sits on it but the panel. */
    background: repeating-linear-gradient(
      90deg,
      var(--colour-maroon) 0,
      color-mix(in srgb, var(--colour-maroon) 65%, var(--colour-black)) 2.5rem,
      var(--colour-maroon) 5rem
    );
  }

  /* ---------- Night sky band ---------- */
  /* Warm white on night: approved pair 15.05:1 */
  .section-page__band {
    background-color: var(--colour-night);
    color: var(--colour-text-on-dark);
    border-block-end: var(--border-m) solid var(--section-colour);
  }

  .section-page__top {
    position: relative;
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    gap: var(--space-l);
    min-height: 13rem;
    padding-block: var(--space-2xl) var(--space-xl);
  }

  .section-page__heading h1 {
    margin: 0;
    font-family: var(--font-display);
    font-size: clamp(2.75rem, 2rem + 4vw, 5rem);
    font-weight: 400; /* Curve Retro has one weight; bold would be faked */
    line-height: 1;
  }

  /* Theatre name: script, in the section colour.
     Mint, butter, green and pink on night are all approved pairs (8.20:1 or more). */
  .section-page__theatre {
    margin: var(--space-xs) 0 0;
    padding-inline-start: var(--space-xl);
    color: var(--section-colour);
    font-family: var(--font-script);
    font-size: clamp(1.75rem, 1.4rem + 1.5vw, 2.5rem);
    line-height: 1.1;
  }

  /* Starbursts float in the empty sky, away from the heading */
  .section-page__star {
    position: absolute;
    color: var(--colour-butter);
  }

  .section-page__star--big {
    top: var(--space-l);
    right: 32%;
    width: 4.5rem;
    color: var(--colour-mustard);
  }

  .section-page__star--small {
    top: 55%;
    right: 45%;
    width: 1.75rem;
  }

  /* The illustration in a soft spotlight of the section colour */
  .section-page__art {
    flex-shrink: 0;
    display: flex;
    align-items: flex-end;
    justify-content: center;
    width: clamp(8rem, 20vw, 13rem);
    aspect-ratio: 1;
    margin-block-end: calc(var(--space-xl) * -1 - var(--border-m));
    background: radial-gradient(
      circle at 50% 60%,
      color-mix(in srgb, var(--section-colour) 55%, transparent) 0,
      transparent 70%
    );
  }

  .section-page__illustration {
    width: auto;
    max-width: 80%;
    max-height: 90%;
    object-fit: contain;
  }

  /* Phones: no room for the stars and illustration beside the heading */
  @media (max-width: 40rem) {
    .section-page__star,
    .section-page__art {
      display: none;
    }

    .section-page__top {
      min-height: 0;
    }
  }

  /* ---------- Content panel ---------- */
  /* Warm white panel, black text: approved pair 18.47:1 */
  .section-page__panel {
    margin-block-start: var(--space-2xl);
    padding: clamp(var(--space-l), 4vw, var(--space-2xl));
    background-color: var(--colour-warm-white);
    color: var(--colour-black);
    box-shadow: 0 1.5rem 3rem color-mix(in srgb, var(--colour-black) 60%, transparent);
  }

  /* The first heading inside the panel doesn't need space above it */
  .section-page__panel > :first-child {
    margin-block-start: 0;
  }
</style>
