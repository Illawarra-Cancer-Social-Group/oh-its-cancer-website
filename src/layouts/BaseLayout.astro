---
/*
  BaseLayout: the frame around every page.

  It adds the page <head>, the skip link, the site header, the <main>
  area and the footer. Every page should use this layout, so the header
  and navigation stay the same everywhere.

  Props:
    title        (required) What this page is about, e.g. "About us".
                 It's shown in the browser tab as "About us | Oh Shit! It's Cancer. Now What?".
                 Every page needs a different title.
    description  (optional) One sentence for search engines and link previews.

  Usage:
    <BaseLayout title="About us">
      <div class="container">
        <h1>About us</h1>
        ...
      </div>
    </BaseLayout>

  Section pages (About us, Products, People, Connect) use SectionLayout,
  which wraps this layout and adds the coloured band and content panel.
*/
import '../styles/global.css';
import SkipLink from '../components/SkipLink.astro';
import SiteNav from '../components/SiteNav.astro';

interface Props {
  title: string;
  description?: string;
}

const { title, description } = Astro.props;

const siteName = 'Oh Shit! It’s Cancer. Now What?';
const pageTitle = `${title} | ${siteName}`;
const year = new Date().getFullYear();
---

<!doctype html>
<html lang="en-AU">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{pageTitle}</title>
    <!-- Start loading the main body font early, so text doesn't jump when it arrives -->
    <link
      rel="preload"
      href="/fonts/atkinson-hyperlegible-next-latin.woff2"
      as="font"
      type="font/woff2"
      crossorigin
    />
    {description && <meta name="description" content={description} />}
  </head>
  <body>
    <SkipLink />

    <header class="site-header surface-dark">
      <div class="container site-header__inner">
        <!-- The site title is real text, not an image (AGENTS.md, section 5) -->
        <a class="site-title" href="/">{siteName}</a>
        <SiteNav />
      </div>
    </header>

    <!-- No width limit here: section pages paint their colour edge to edge.
         Pages put their content inside class="container". -->
    <main id="main" tabindex="-1">
      <slot />
    </main>

    <footer class="site-footer surface-dark">
      <div class="container">
        <p>© {year} Illawarra Cancer Social Group</p>
      </div>
    </footer>
  </body>
</html>

<style>
  /* Header and footer: warm white text on night, approved pair 15.05:1 */
  .site-header,
  .site-footer {
    background-color: var(--colour-night);
    color: var(--colour-text-on-dark);
  }

  /* Title on the left, menu on the right; they stack when there isn't room */
  .site-header__inner {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-xs) var(--space-xl);
    padding-block: var(--space-s);
  }

  .site-title {
    display: inline-flex;
    align-items: center;
    min-height: var(--tap-target-min);
    color: var(--colour-text-on-dark);
    font-family: var(--font-display);
    font-size: var(--text-h3);
    font-weight: 400; /* Federo has one weight; bold would be faked */
    text-decoration: none;
  }

  .site-title:hover {
    text-decoration: underline;
  }

  /* Keeps the footer at the bottom of the window on short pages */
  body {
    display: flex;
    flex-direction: column;
    min-height: 100vh;
  }

  main {
    display: flex;
    flex-direction: column;
    flex: 1;
  }

  /* The page's own content fills the space, so section colours reach the footer */
  main > :global(*) {
    flex: 1;
  }

  /* No outline when the skip link moves focus here: main is a landing spot, not a control */
  main:focus {
    outline: none;
  }

  .site-footer {
    padding-block: var(--space-xl);
  }

  .site-footer p {
    margin: 0;
  }
</style>
