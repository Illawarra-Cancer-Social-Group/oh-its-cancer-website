---
/*
  PageHeading: the <h1> at the top of a page, with its theatre name.

  The plain label is the large heading. The theatre name sits smaller
  underneath (AGENTS.md, section 5: plain labels first, theatre names second).
  Both come from src/navigation.ts, so they match the menu.

  Props:
    href  (required) The page's web address in src/navigation.ts, e.g. "/products/".
*/
import { navItem } from '../navigation';

interface Props {
  href: string;
}

const { label, theatreName } = navItem(Astro.props.href);
---

<div class="page-heading">
  <h1>{label}</h1>
  {theatreName && <p class="page-heading__theatre">{theatreName}</p>}
</div>

<style>
  .page-heading {
    margin-block-end: var(--space-l);
  }

  .page-heading h1 {
    margin-block: 0 var(--space-2xs);
  }

  /* Default black on warm white: approved pair 18.47:1 */
  .page-heading__theatre {
    margin: 0;
    font-family: var(--font-display);
    font-size: var(--text-h4);
    font-style: italic;
  }
</style>
